          }
        ],
        "partitions": [
          {
            "name": "fct_order_items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = if DataSourceMode = \"BigQuery\" then",
                "        let",
                "            Projects = GoogleBigQuery.Database([BillingProject=BillingProject, Implementation=\"2.0\"]),",
                "            Project = Projects{[Name=BillingProject]}[Data],",
                "            Dataset = Project{[Name=BigQueryDataset, Kind=\"Schema\"]}[Data]",
                "        in Dataset{[Name=\"fct_order_items\"]}[Data]",
                "    else",
                "        Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & \"/fct_order_items.csv\"),",
                "            [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    EmptyToNull = Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),",
                "    Typed = Table.TransformColumnTypes(EmptyToNull, {{\"order_id\", type text}, {\"order_item_id\", Int64.Type}, {\"product_id\", type text}, {\"seller_id\", type text}, {\"shipping_limit_date\", type datetime}, {\"price_cents\", Int64.Type}, {\"freight_value_cents\", Int64.Type}, {\"customer_id\", type text}, {\"date_key\", Int64.Type}, {\"purchase_date\", type datetime}, {\"purchase_month\", type text}, {\"order_status\", type text}, {\"is_eligible_gmv\", type logical}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
